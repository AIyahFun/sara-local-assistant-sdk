{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sara-assistant.dev/schemas/capability.schema.json",
  "title": "SARA assistant capability snapshot",
  "type": "object",
  "required": ["schemaVersion", "available", "asOf"],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "available": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
