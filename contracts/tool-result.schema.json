{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sara-assistant.dev/schemas/tool-result.schema.json",
  "title": "SARA assistant tool result",
  "type": "object",
  "required": ["ok", "status", "meta"],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "status": {
      "enum": ["succeeded", "failed", "cancelled", "timed_out"]
    },
    "data": {
      "type": "object"
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "INVALID_ARGUMENT",
            "TOOL_UNAVAILABLE",
            "NOT_AUTHORIZED",
            "CONFIRMATION_REQUIRED",
            "NOT_IMPLEMENTED",
            "CONFLICT",
            "TIMEOUT",
            "OFFLINE",
            "STALE_DATA",
            "EXECUTION_FAILED"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      },
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "required": ["requestId", "toolVersion", "source", "durationMs"],
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 80
        },
        "toolVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "source": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": { "const": true }
        }
      },
      "then": {
        "required": ["data"],
        "properties": {
          "data": {},
          "error": false
        }
      },
      "else": {
        "required": ["error"],
        "properties": {
          "error": {},
          "data": false
        }
      }
    }
  ],
  "additionalProperties": false
}
